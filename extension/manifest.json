{
  "manifest_version": 3,
  "name": "Shadow AI Detector",
  "version": "3.1",
  "description": "Detects and monitors risky Shadow AI and social media usage in organizational environments",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://chat.openai.com/*",
        "*://*.openai.com/*",
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://gemini.google.com/*",
        "*://copilot.microsoft.com/*",
        "*://*.copilot.microsoft.com/*",
        "*://bard.google.com/*",
        "*://character.ai/*",
        "*://*.character.ai/*",
        "*://perplexity.ai/*",
        "*://*.perplexity.ai/*",
        "*://you.com/*",
        "*://*.you.com/*",
        "*://huggingface.co/*",
        "*://*.huggingface.co/*",
        "*://chat.deepseek.com/*",
        "*://grok.com/*",
        "*://*.grok.com/*",
        "*://meta.ai/*",
        "*://*.meta.ai/*",
        "*://chat.mistral.ai/*",
        "*://poe.com/*",
        "*://*.poe.com/*",
        "*://pi.ai/*",
        "*://*.pi.ai/*",
        "*://qwen.ai/*",
        "*://chat.qwen.ai/*",
        "*://kimi.com/*",
        "*://*.kimi.com/*",
        "*://otter.ai/*",
        "*://*.otter.ai/*",
        "*://jasper.ai/*",
        "*://app.jasper.ai/*",
        "*://www.facebook.com/*",
        "*://facebook.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://www.instagram.com/*",
        "*://www.linkedin.com/*",
        "*://www.reddit.com/*",
        "*://*.reddit.com/*",
        "*://www.tiktok.com/*",
        "*://web.whatsapp.com/*",
        "*://web.telegram.org/*",
        "*://www.snapchat.com/*",
        "*://www.pinterest.com/*",
        "*://www.threads.net/*"
      ],
      "js": ["sensitive-keywords.js", "sensitive-patterns.js", "keyword-matcher.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html" }
}
